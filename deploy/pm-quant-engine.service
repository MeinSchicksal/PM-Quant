[Unit]
Description=PM-Quant Automated Paper Trading Engine (Isolated Process)
After=network-online.target time-sync.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/pm-quant
Environment="PYTHONUNBUFFERED=1"
Environment="PM_TZ_OFFSET_HOURS=8"
EnvironmentFile=-/etc/pm-quant.env
ExecStart=/opt/pm-quant/.venv/bin/python main.py run
Restart=always
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGTERM

# Dedicated memory budget isolated from public Web dashboard traffic
MemoryHigh=256M
MemoryMax=384M
MemorySwapMax=128M
NoNewPrivileges=true
LimitNOFILE=8192

StandardOutput=journal
StandardError=journal
SyslogIdentifier=pm-quant-engine

[Install]
WantedBy=multi-user.target
